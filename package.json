{
  "name": "reach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build --turbopack",
    "start": "tsx scripts/require-secret.ts && next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "user:set-password": "tsx scripts/set-password.ts",
    "qa:login": "tsx scripts/login-assert.ts",
    "qa:auth": "tsx scripts/auth-assert.ts",
    "qa:assert": "tsx scripts/login-assert.ts && tsx scripts/qa-assert.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.12",
    "openid-client": "^6.8.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
